+// dialPreferIPv6 dials the resolved addresses through the tunnel, IPv6 first, then IPv4.
+// Cloudflare's shared WARP IPv4 exit addresses are blocked by many sites, while the per-user IPv6
+// ones are not, and the original code always dialled ips[0] (IPv4 whenever the device itself has no
+// IPv6 route, because Go sorts the lookup result by the host's connectivity). Falls back to the
+// next address when one fails, so IPv4-only or broken-AAAA hosts still work.
+func dialPreferIPv6(ctx context.Context, tunNet *netstack.Net, network string, ips []net.IP, port string) (net.Conn, error) {
+	ordered := make([]net.IP, 0, len(ips))
+	for _, ip := range ips {
+		if ip.To4() == nil {
+			ordered = append(ordered, ip)
+		}
+	}
+	for _, ip := range ips {
+		if ip.To4() != nil {
+			ordered = append(ordered, ip)
+		}
+	}
+	var lastErr error
+	for _, ip := range ordered {
+		attemptCtx, cancel := context.WithTimeout(ctx, 6*time.Second)
+		conn, err := tunNet.DialContext(attemptCtx, network, net.JoinHostPort(ip.String(), port))
+		cancel()
+		if err == nil {
+			return conn, nil
+		}
+		lastErr = err
+		if ctx.Err() != nil {
+			break
+		}
+	}
+	if lastErr == nil {
+		lastErr = fmt.Errorf("no addresses to dial")
+	}
+	return nil, lastErr
+}
