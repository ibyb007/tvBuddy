<?xml version="1.0" encoding="utf-8"?>
<!-- Private keys (WireGuard config, WARP account) must never leave the device through backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="wireguard/" />
        <exclude domain="file" path="warp/" />
        <exclude domain="file" path="updates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="wireguard/" />
        <exclude domain="file" path="warp/" />
        <exclude domain="file" path="updates/" />
    </device-transfer>
</data-extraction-rules>
